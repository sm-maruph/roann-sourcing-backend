PORT=4000
# PostgreSQL 14+ on any host, including a direct Supabase PostgreSQL connection.
# Use the application schema owner. For remote TLS use sslmode=verify-full and your provider CA.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres?sslmode=verify-full
# Supabase now; change to local when moving files to your own server.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only storage key. This is NOT your custom admin password.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
SUPABASE_STORAGE_BUCKET=site-media
MEDIA_DIRECTORY=./uploads
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0
# Used only by npm run admin:create. Choose your own credentials; remove password afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
